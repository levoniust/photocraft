[Desktop Entry]
Type=Application
Name=PhotoCraft
GenericName=Image Editor
Comment=Edit photos and layered PSD documents
Exec=photocraft %F
TryExec=photocraft
Icon=ai.storyteller.photocraft
Terminal=false
# The native runner does not complete desktop startup-notification handshakes.
StartupNotify=false
StartupWMClass=ai.storyteller.photocraft
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;image;editor;psd;layers;retouch;paint;
MimeType=application/x-photocraft;image/x-paintnet;image/openraster;application/x-krita;image/vnd.adobe.photoshop;image/x-psd;image/x-psb;image/png;image/jpeg;image/tiff;image/webp;image/gif;image/bmp;image/x-tga;image/x-icon;image/vnd.microsoft.icon;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-exr;image/vnd.radiance;image/avif;image/qoi;image/x-nikon-nef;image/x-nikon-nrw;image/x-adobe-dng;image/x-canon-cr2;image/x-canon-cr3;image/x-sony-arw;image/x-sony-srf;image/x-sony-sr2;image/x-pentax-pef;image/x-olympus-orf;image/x-panasonic-rw2;image/x-fuji-raf;
# AppRun registers the desktop entry and icons itself (#593); tell external
# AppImage integrators (AppImageLauncher, appimaged) not to add a duplicate (#3623).
X-AppImage-Integrate=false
